{{ 'cart-mobile.css' | asset_url | stylesheet_tag }}
<section class="section">
  <div class="container">
    <h1>Sepetin</h1>
    <div class="band-divider" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <p>Sepetin şu an boş. Hadi bir projeye başlayalım!</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Ürünlere göz at</a>
      </div>
    {%- else -%}
      {%- assign shipping_threshold = 120000 -%}
      {%- assign shipping_remaining = shipping_threshold | minus: cart.items_subtotal_price -%}
      {%- if shipping_remaining > 0 -%}
        {%- assign shipping_percent = cart.items_subtotal_price | times: 1.0 | divided_by: shipping_threshold | times: 100 -%}
      {%- else -%}
        {%- assign shipping_percent = 100 -%}
      {%- endif -%}
      <div class="shipping-progress {% if shipping_remaining <= 0 %}is-complete{% endif %}" data-shipping-bar data-threshold="{{ shipping_threshold }}">
        <p class="shipping-progress__text" data-shipping-text>
          {%- if shipping_remaining > 0 -%}
            Ücretsiz kargoya <strong>{{ shipping_remaining | money }}</strong> kaldı! 🚚
          {%- else -%}
            Tebrikler, kargon ücretsiz! 🎉
          {%- endif -%}
        </p>
        <div class="shipping-progress__track">
          <div class="shipping-progress__fill" data-shipping-fill style="width: {{ shipping_percent }}%"></div>
        </div>
      </div>

      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="cart-table">
          <thead>
            <tr><th>Ürün</th><th>Adet</th><th>Toplam</th></tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="cart-item">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 144 }}" alt="" width="72" height="72">
                    {%- endif -%}
                    <div>
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                      {%- unless item.variant.title == 'Default Title' -%}<div>{{ item.variant.title }}</div>{%- endunless -%}
                    </div>
                  </div>
                </td>
                <td>
                  <div class="qty-stepper qty-stepper--sm" data-qty-stepper>
                    <button type="button" class="qty-stepper__btn" data-qty-minus aria-label="Adedi azalt">&minus;</button>
                    <input class="qty-input" type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-key="{{ item.key }}" data-prev="{{ item.quantity }}" data-name="{{ item.product.title | escape }}" aria-label="{{ item.product.title }} adedi">
                    <button type="button" class="qty-stepper__btn" data-qty-plus aria-label="Adedi artır">+</button>
                  </div>
                </td>
                <td data-line-total>{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-footer">
          <div class="cart-summary">
            <div class="cart-summary__row"><span>Ara toplam</span><span data-cart-subtotal>{{ cart.items_subtotal_price | money }}</span></div>
            <small>KDV dahil. Kargo ödeme adımında hesaplanır.</small>

            <style>
              .cart-inv{margin:16px 0 4px;padding:14px;border:1px solid #e1e3ec;border-radius:10px;background:#fafbfd;display:grid;gap:10px}
              .cart-inv__title{margin:0;font-size:14px;font-weight:700;color:#1b2a4a}
              .cart-inv__note{margin:-4px 0 0;font-size:12px;color:#6b7280;line-height:1.4}
              .cart-inv__row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
              .cart-inv label{display:grid;gap:4px;font-size:12.5px;font-weight:600;color:#1b2a4a}
              .cart-inv select,.cart-inv input[type=text]{width:100%;box-sizing:border-box;padding:9px 10px;border:1px solid #c9cdd9;border-radius:7px;font:inherit;font-size:14px;font-weight:400;background:#fff;color:#1b2a4a}
              .cart-inv select:disabled{background:#f1f2f6;color:#9aa0ad}
              .cart-inv .is-invalid{border-color:#c0392b;box-shadow:0 0 0 2px rgba(192,57,43,.12)}
              .cart-inv__type{display:flex;gap:8px}
              .cart-inv__type label{flex:1;display:flex;align-items:center;gap:8px;padding:9px 10px;border:1px solid #c9cdd9;border-radius:7px;background:#fff;cursor:pointer;font-weight:600}
              .cart-inv__type input{accent-color:#17204D;margin:0}
              .cart-inv__type label:has(input:checked){border-color:#17204D;box-shadow:inset 0 0 0 1px #17204D}
              .cart-inv__corp{display:grid;gap:10px}
              .cart-inv__corp[hidden]{display:none}
              .cart-inv__error{margin:0;font-size:12.5px;color:#c0392b}
              @media (max-width:520px){.cart-inv__row{grid-template-columns:1fr}}
            </style>
            {%- assign inv_tip = cart.attributes['Fatura tipi'] | default: 'Bireysel' -%}
            <div class="cart-inv" data-cart-inv>
              <p class="cart-inv__title">Teslimat ve fatura bilgileri</p>
              <p class="cart-inv__note">Faturanın doğru kesilmesi için il, ilçe ve mahalleyi seç. Ödeme sayfasındaki adreste de aynı bilgileri yaz.</p>
              <div class="cart-inv__row">
                <label>İl
                  <select name="attributes[Il]" data-inv-il data-value="{{ cart.attributes['Il'] | escape }}" required>
                    <option value="">İl seçin</option>
                  </select>
                </label>
                <label>İlçe
                  <select name="attributes[Ilce]" data-inv-ilce data-value="{{ cart.attributes['Ilce'] | escape }}" required disabled>
                    <option value="">Önce il seçin</option>
                  </select>
                </label>
              </div>
              <label>Mahalle
                <input type="text" name="attributes[Mahalle]" value="{{ cart.attributes['Mahalle'] | escape }}" data-inv-mahalle maxlength="80" autocomplete="off" placeholder="Örn. Tomalar Mahallesi" required>
              </label>
              <div class="cart-inv__type" role="radiogroup" aria-label="Fatura tipi">
                <label><input type="radio" name="attributes[Fatura tipi]" value="Bireysel" data-inv-tip {% if inv_tip != 'Kurumsal' %}checked{% endif %}> Bireysel fatura</label>
                <label><input type="radio" name="attributes[Fatura tipi]" value="Kurumsal" data-inv-tip {% if inv_tip == 'Kurumsal' %}checked{% endif %}> Kurumsal fatura</label>
              </div>
              <div class="cart-inv__corp" data-inv-corp {% if inv_tip != 'Kurumsal' %}hidden{% endif %}>
                <label>Firma / kurum unvanı
                  <input type="text" name="attributes[Firma unvani]" value="{{ cart.attributes['Firma unvani'] | escape }}" data-inv-req maxlength="150">
                </label>
                <div class="cart-inv__row">
                  <label>Vergi dairesi
                    <input type="text" name="attributes[Vergi dairesi]" value="{{ cart.attributes['Vergi dairesi'] | escape }}" data-inv-req maxlength="60">
                  </label>
                  <label>Vergi no / TC kimlik no
                    <input type="text" name="attributes[Vergi no]" value="{{ cart.attributes['Vergi no'] | escape }}" data-inv-req data-inv-vkn inputmode="numeric" maxlength="11" placeholder="10 veya 11 hane">
                  </label>
                </div>
              </div>
              <p class="cart-inv__error" data-inv-error hidden></p>
            </div>
