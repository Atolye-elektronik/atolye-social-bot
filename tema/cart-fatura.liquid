            </label>
            <input type="hidden" name="attributes[Sozlesme onayi]" value="" data-cart-terms-value>
            <p class="cart-terms__error" data-cart-terms-error hidden>Ödemeye geçmek için ön bilgilendirme formunu ve sözleşmeyi onaylaman gerekiyor.</p>

            <button type="submit" name="checkout" class="btn btn--primary btn--full">Ödemeye geç</button>
            <div class="cart-payment-note">
              <small>Güvenli ödeme — 256-bit SSL</small>
              {% render 'payment-icons' %}
            </div>

            <style>
              .cart-trust{margin-top:14px;border-top:1px solid #ececf1;padding-top:14px}
              .cart-trust__grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px 14px}
              .cart-trust__grid li{display:flex;gap:8px;align-items:flex-start}
              .cart-trust__ic{font-size:18px;line-height:1.2;flex:none}
              .cart-trust__grid strong{display:block;font-size:13px;color:#1b2a4a;font-weight:600;line-height:1.3}
              .cart-trust__grid em{font-style:normal;font-size:12px;color:#6b7280}
              .cart-trust__social{margin:12px 0 0;text-align:center;font-size:13px;color:#1b2a4a}
              .cart-trust__social a{color:#1b2a4a;text-decoration:none;border-bottom:1px dotted #b7bcd0;white-space:nowrap}
              .cart-trust__social .star{color:#f5a623}
              .cart-trust__wa{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:12px;padding:10px;border-radius:8px;background:#e8f6ee;color:#128c4b;font-size:13px;font-weight:600;text-decoration:none}
            </style>
            <div class="cart-trust">
              <ul class="cart-trust__grid">
                <li><span class="cart-trust__ic">🔒</span><div><strong>Güvenli ödeme</strong><em>256-bit SSL · kart bilgin bize ulaşmaz</em></div></li>
                <li><span class="cart-trust__ic">🚚</span><div><strong>Hızlı kargo</strong><em>Aynı/ertesi iş günü kargoda</em></div></li>
                <li><span class="cart-trust__ic">↩️</span><div><strong>Kolay iade</strong><em>14 gün içinde cayma hakkı</em></div></li>
                <li><span class="cart-trust__ic">🧾</span><div><strong>Faturalı satış</strong><em>Her siparişte e-arşiv fatura</em></div></li>
              </ul>
              <p class="cart-trust__social">
                <a href="https://www.trendyol.com/magaza/atolye-elektronik-m-1258869" target="_blank" rel="noopener"><span class="star">★</span> Trendyol 9.7/10</a>
                &nbsp;·&nbsp;
                <a href="https://www.hepsiburada.com/magaza/atolye-elektronik" target="_blank" rel="noopener">Hepsiburada'da yüzlerce olumlu yorum</a>
              </p>
              <a class="cart-trust__wa" href="https://wa.me/905468253210?text=Merhaba,%20sipari%C5%9F%20%C3%B6ncesi%20bir%20sorum%20var" target="_blank" rel="noopener">💬 Sipariş öncesi soru? WhatsApp'tan yaz</a>
            </div>
          </div>
        </div>
      </form>
      <script>
        (function () {
          var btn = document.querySelector('button[name="checkout"]');
          var box = document.querySelector('[data-cart-terms]');
          var val = document.querySelector('[data-cart-terms-value]');
          var err = document.querySelector('[data-cart-terms-error]');
          if (!btn || !box) return;

          var inv = document.querySelector('[data-cart-inv]');
          var il = inv && inv.querySelector('[data-inv-il]');
          var ilce = inv && inv.querySelector('[data-inv-ilce]');
          var mah = inv && inv.querySelector('[data-inv-mahalle]');
          var corp = inv && inv.querySelector('[data-inv-corp]');
          var invErr = inv && inv.querySelector('[data-inv-error]');
          var data = {};
          try { data = JSON.parse(document.querySelector('[data-inv-data]').textContent); } catch (e) {}
          var trSort = function (a, b) { return a.localeCompare(b, 'tr'); };

          function fillIlce(keep) {
            var list = data[il.value] || [];
            ilce.innerHTML = '';
            var first = document.createElement('option');
            first.value = '';
            first.textContent = il.value ? 'İlçe seçin' : 'Önce il seçin';
            ilce.appendChild(first);
            list.forEach(function (n) {
              var o = document.createElement('option');
              o.value = n; o.textContent = n;
              ilce.appendChild(o);
            });
            ilce.disabled = !list.length;
            ilce.value = keep && list.indexOf(keep) > -1 ? keep : '';
          }

          if (il) {
            Object.keys(data).sort(trSort).forEach(function (n) {
              var o = document.createElement('option');
              o.value = n; o.textContent = n;
              il.appendChild(o);
            });
            if (il.dataset.value && data[il.dataset.value]) il.value = il.dataset.value;
            fillIlce(ilce.dataset.value);
            il.addEventListener('change', function () { fillIlce(''); });
            inv.querySelectorAll('[data-inv-tip]').forEach(function (r) {
              r.addEventListener('change', function () {
                corp.hidden = !(r.checked && r.value === 'Kurumsal');
              });
            });
            inv.addEventListener('input', function (e) { e.target.classList.remove('is-invalid'); });
            inv.addEventListener('change', function (e) { e.target.classList.remove('is-invalid'); });
          }

          function invCheck() {
            if (!inv) return true;
            var bad = [];
            [il, ilce].forEach(function (s) { if (!s.value) bad.push(s); });
            if (mah.value.trim().length < 3) bad.push(mah);
            var kurumsal = !corp.hidden;
            corp.querySelectorAll('[data-inv-req]').forEach(function (f) {
              if (!kurumsal) { f.value = ''; return; }
              var v = f.value.trim();
              if (f.hasAttribute('data-inv-vkn')) {
                v = v.replace(/\D/g, '');
                f.value = v;
                if (v.length !== 10 && v.length !== 11) bad.push(f);
              } else if (v.length < 2) bad.push(f);
            });
            inv.querySelectorAll('.is-invalid').forEach(function (f) { f.classList.remove('is-invalid'); });
            bad.forEach(function (f) { f.classList.add('is-invalid'); });
            if (bad.length) {
              invErr.textContent = kurumsal
                ? 'İl, ilçe, mahalle ve kurumsal fatura bilgilerini (unvan, vergi dairesi, 10 haneli vergi no ya da 11 haneli TC) doldur.'
                : 'Ödemeye geçmek için il, ilçe ve mahalleyi doldur.';
              invErr.hidden = false;
              bad[0].focus();
              return false;
            }
            invErr.hidden = true;
            mah.value = mah.value.trim();
            return true;
          }

          btn.addEventListener('click', function (ev) {
            if (!invCheck()) {
              ev.preventDefault();
              ev.stopImmediatePropagation();
              return;
            }
            if (!box.checked) {
              ev.preventDefault();
              ev.stopImmediatePropagation();
              err.hidden = false;
              box.focus();
              return;
            }
            val.value = 'Onaylandı - ' + new Date().toLocaleString('tr-TR');
          }, true);
          box.addEventListener('change', function () { if (box.checked) err.hidden = true; });
        })();
      </script>

      <div class="cart-confirm-overlay" data-cart-confirm hidden>
        <div class="cart-confirm-box">
          <h3>Ürünü sepetten kaldır?</h3>
          <p data-cart-confirm-text>Bu ürünü sepetten kaldırmak istediğine emin misin?</p>
          <div class="cart-confirm-actions">
            <button type="button" class="btn cart-confirm-danger" data-cart-confirm-ok>Evet, kaldır</button>
            <button type="button" class="btn btn--ghost" data-cart-confirm-cancel>Vazgeç, sepette kalsın</button>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
