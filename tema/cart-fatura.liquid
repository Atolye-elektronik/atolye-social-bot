              .cart-terms input{width:18px;height:18px;margin:1px 0 0;flex:none;accent-color:#17204D}
              .cart-terms a{color:#17204D;text-decoration:underline}
              .cart-terms__error{margin:0 0 8px;font-size:12.5px;color:#c0392b}
            </style>
            <label class="cart-terms" for="cart-terms">
              <input type="checkbox" id="cart-terms" data-cart-terms>
